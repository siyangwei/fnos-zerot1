+
+/* ZT1: on this platform the very first modeset happens before VOP is
+ * streaming, so the panel stays dark until the output is re-programmed.
+ * One connector re-probe after boot fixes it without any userspace help. */
+static int analogix_dp_config_video(struct analogix_dp_device *dp);
+
+static void zt1_rekick_work(struct work_struct *work)
+{
+	struct analogix_dp_device *dp =
+		container_of(work, struct analogix_dp_device, zt1_work.work);
+
+	struct drm_atomic_state *st;
+
+	dev_info(dp->dev, "ZT1: full modeset retry (boot quirk)\n");
+	st = drm_atomic_helper_suspend(dp->drm_dev);
+	if (IS_ERR(st)) {
+		dev_warn(dp->dev, "ZT1: suspend failed %ld\n", PTR_ERR(st));
+		return;
+	}
+	msleep(150);
+	dev_info(dp->dev, "ZT1: resume ret=%d\n",
+		 drm_atomic_helper_resume(dp->drm_dev, st));
+}
