+/* ZT1: eDP output gate lives in vop_grf; mainline vop2 has no eDP support */
+static void zt1_vop_grf_edp0_enable(struct analogix_dp_device *dp)
+{
+	void __iomem *grf;
+	u32 v;
+
+	if (!zt1_vopgrf)
+		return;
+	grf = ioremap(0xfd5a4000, 0x100);
+	if (!grf) {
+		dev_warn(dp->dev, "ZT1: vop_grf ioremap failed\n");
+		return;
+	}
+	v = readl(grf + 0x08);
+	dev_info(dp->dev, "ZT1: VOP_GRF_CON2=0x%08x edp0_en=%u\n", v, v & 1);
+	if (!(v & 1))
+		writel(v | 0x00010001, grf + 0x08); /* bit0 + write mask */
+	dev_info(dp->dev, "ZT1: VOP_GRF_CON2 after=0x%08x\n", readl(grf + 0x08));
+	iounmap(grf);
+
+	/* ZT1: VO1 output mode select (edp_mode) lives in vo1_grf CON0 bit0.
+	 * Rockchip BSP sets it in rockchip_dp_poweron_start(); the mainline
+	 * glue in this kernel never does, and then VO1 feeds HDMI0 instead
+	 * of eDP0 and the panel stays black. */
+	if (zt1_vogrfg) {
+		grf = ioremap(0xfd5a8000, 0x100);
+		if (grf) {
+			dev_info(dp->dev, "ZT1: VO1_GRF_CON0 before=0x%08x\n",
+				 readl(grf));
+			writel(0x00010001, grf);	/* bit0 + write mask */
+			dev_info(dp->dev, "ZT1: VO1_GRF_CON0 after=0x%08x\n",
+				 readl(grf));
+			iounmap(grf);
+		}
+	}
+}
