+#define TOTAL_PIXEL_CFG_H(x)			(((x) & 0x3f) << 0)
+#define ACTIVE_PIXEL_CFG_L(x)			(((x) & 0xff) << 0)
+#define ACTIVE_PIXEL_CFG_H(x)			(((x) & 0x3f) << 0)
+#define H_F_PORCH_CFG_L(x)			(((x) & 0xff) << 0)
