--- a/drivers/usb/typec/tcpm/tcpm.c	2026-11-10 23:05:58.717892149 +0800
+++ b/drivers/usb/typec/tcpm/tcpm.c	2026-11-10 23:05:58.718882091 +0800
@@ -7807,6 +7807,8 @@
 	struct tcpm_port *port;
 	int err;
 
+	pr_info("tcpm: zt1 defer-fix build loaded\n");
+
 	if (!dev || !tcpc ||
 	    !tcpc->get_vbus || !tcpc->set_cc || !tcpc->get_cc ||
 	    !tcpc->set_polarity || !tcpc->set_vconn || !tcpc->set_vbus ||
@@ -7877,6 +7879,24 @@
 	port->partner_desc.identity = &port->partner_ident;
 
 	port->role_sw = fwnode_usb_role_switch_get(tcpc->fwnode);
+	/*
+	 * zt1 fix: fwnode_usb_role_switch_get() returns -EPROBE_DEFER when the
+	 * graph references a role switch whose device has not been registered
+	 * yet (e.g. dwc3 usb_role_switch comes up after the fusb302/tcpm i2c
+	 * client on RK3588). The historical IS_ERR_OR_NULL() check swallowed
+	 * that defer, fell back to usb_role_switch_get(port->dev) which also
+	 * returns NULL, and then probe succeeded with port->role_sw == NULL:
+	 * tcpm kept updating /sys/class/typec data_role but never switched
+	 * dwc3, so Type-C host/device role switching silently failed at
+	 * random boots. Propagate the defer so the driver core retries probe
+	 * once dwc3 is ready.
+	 */
+	if (IS_ERR(port->role_sw) && PTR_ERR(port->role_sw) == -EPROBE_DEFER) {
+		pr_info("tcpm: %s: usb role switch not ready, deferring probe\n",
+			dev_name(dev));
+		err = -EPROBE_DEFER;
+		goto out_destroy_wq;
+	}
 	if (IS_ERR_OR_NULL(port->role_sw))
 		port->role_sw = usb_role_switch_get(port->dev);
 	if (IS_ERR(port->role_sw)) {
@@ -7954,3 +7974,4 @@
 MODULE_AUTHOR("Guenter Roeck <groeck@chromium.org>");
 MODULE_DESCRIPTION("USB Type-C Port Manager");
 MODULE_LICENSE("GPL");
+MODULE_VERSION("zt1-defer-fix");
