# ============================================================================
# config.env.example —— zeroT1 (AIOT-3588A) fnOS 镜像构建配置模板
#
# 用法：cp config.env.example config.env，按需修改后再构建。
#       config.env 已被 .gitignore 忽略（内含 WiFi/root 密码，不入库）。
#       GitHub Actions 构建时由 Actions Secrets 注入同名变量（见 .github/workflows/build.yml），
#       不需要把真实密码写进仓库。
#
# 格式：KEY=value（可加引号，可写注释）。外部环境变量优先——命令行/Actions
#       传同名变量会覆盖这里的值。
# ============================================================================

# ── 网络（首启自动连接，连上后即可 SSH）──────────────────────────────────
# 主 WiFi；WIFI_FALLBACK_* 为连不上主 WiFi 时的备用（留空则只用主 WiFi）
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_FALLBACK_SSID=""
WIFI_FALLBACK_PASSWORD=""
# 隐藏 SSID 时改 1
WIFI_HIDDEN="0"
# 射频国家码。默认 US：BCM43455 固件在国家码为 world/CN 时不扫描 5GHz DFS 信道
# （ch52-64/100-144），国内运营商 5G 常用 DFS，表现为「5G 搜不到」。
# 需要严格 CN 域可改回 CN（代价：DFS 信道 5G 不可用）。
WIFI_COUNTRY="US"
# 0 = 不在根文件系统装 WiFi 首启脚本（纯有线场景）
ENABLE_WIFI="1"

# ── SSH / 登录 ────────────────────────────────────────────────────────────
# 1 = 开机自启 sshd，允许 root 密码登录（首次开机即可 ssh root@<ip>）
ENABLE_SSH="1"
# root 密码（同时用于串口 console 登录）；留空则保持底稿默认
ROOT_PASSWORD=""    # 留空 = 使用默认 root/root（官方镜像默认值）

# ── 主机名 ────────────────────────────────────────────────────────────────
# 留空 = 保持出厂态 "fnnas"，由 fnOS Web 向导注册管理员时设置；
# 填了则构建时写成固定主机名（会跳过向导里的主机名步骤）
DEVICE_HOSTNAME=""

# ── 构建开关 ──────────────────────────────────────────────────────────────
# 1 = 跳过 XFCE 桌面（纯 NAS，构建更快）
SKIP_XFCE="0"

# ── 调试通道 ──────────────────────────────────────────────────────────────
# 1 = 打开 USB adb（插 USB-C 到 PC 即可 adb shell；USB3 SuperSpeed）
ENABLE_ADB="1"
# 有线网口调试用静态 IP（网线直连主机时用；留空 = 不配置）
DEBUG_ETH_IP=""
DEBUG_ETH_IFACE="eth0"
# Type-C（唯一 OTG 口）角色由内核 tcpm 原生自动切换，无配置项。
