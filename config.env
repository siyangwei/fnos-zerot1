# ============================================================================
# config.env —— zeroT1 (AIOT-3588A) fnOS 镜像构建配置
#
# 位置：仓库根目录。构建脚本（scripts/*.sh）与 GitHub Actions 都会读取它；
#       同时会被打进镜像（/etc/zerot1/config.env），开机首次启动脚本也读它。
#
# 格式：KEY=value（可加引号，可写注释）。外部环境变量优先——命令行/Actions
#       传同名变量会覆盖这里的值，方便 CI 用 Secrets 注入密码而不改文件。
#
# 修改后重新打包镜像即可生效：
#   sudo env SKIP_ROOTFS=1 SKIP_KERNEL=1 \
#        FNOS_BOOT=$PWD/work/boot-fix-2214 IMAGE_DIR=$PWD/work/images \
#        ROOTFS=$PWD/work/rootfs-official bash scripts/build-all.sh
# ============================================================================

# ── 网络（首启自动连接，连上后即可 SSH）──────────────────────────────────
# 主 WiFi；WIFI_FALLBACK_* 为连不上主 WiFi 时的备用（留空则只用主 WiFi）
WIFI_SSID="CMCC-jRxU-5G"
WIFI_PASSWORD="34qs75h2"
WIFI_FALLBACK_SSID="CMCC-jRxU"
WIFI_FALLBACK_PASSWORD="34qs75h2"
# 隐藏 SSID 时改 1
WIFI_HIDDEN="0"
WIFI_COUNTRY="CN"
# 0 = 不在根文件系统装 WiFi 首启脚本（纯有线场景）
ENABLE_WIFI="1"

# ── SSH / 登录 ────────────────────────────────────────────────────────────
# 1 = 开机自启 sshd，允许 root 密码登录（首次开机即可 ssh root@<ip>）
ENABLE_SSH="1"
# root 密码（同时用于串口 console 登录）
ROOT_PASSWORD="weisiyang"

# ── 主机名 ────────────────────────────────────────────────────────────────
# 留空 = 保持出厂态 "fnnas"，由 fnOS Web 向导注册管理员时设置；
# 填了则构建时写成固定主机名（会跳过向导里的主机名步骤）
DEVICE_HOSTNAME=""

# ── 构建开关 ──────────────────────────────────────────────────────────────
# 1 = 跳过 XFCE 桌面（纯 NAS，构建更快）
SKIP_XFCE="0"

# ── 调试通道（2026-10-30 新增）───────────────────────────────────────────────
# 1 = 打开 USB adb（插 USB-C 到 PC 即可 adb shell；厂商 adbd + 最小 gadget）
ENABLE_ADB="1"
# 有线网口调试用静态 IP（网线直连主机时用；留空 = 不配置）
# 主机侧建议：ip addr add 192.168.1.101/32 dev <usb网卡>; ip route replace 192.168.1.100/32 dev <usb网卡>
DEBUG_ETH_IP="192.168.1.100/24"
DEBUG_ETH_IFACE="eth0"
# Type-C 默认角色：host = OTG 自动切换（插 PC 变 device 跑 adb，插 U 盘当主机；默认）
# device = 强制固定为 device（禁用 fusb302 的变体 dtb，一般不推荐）
# 运行时切换：zt1-usb-role device|host（改 extlinux 的 fdt 后自动重启）
USB_ROLE="host"
