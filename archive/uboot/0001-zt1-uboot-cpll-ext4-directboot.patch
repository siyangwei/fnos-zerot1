+int zt1_set_cpll_1500(void)
+{
+	struct udevice *dev;
+	struct rk3588_clk_priv *priv;
+	ofnode node;
+	int ret;
+
+	node = ofnode_path("/clock-controller@fd7c0000");
+	if (!ofnode_valid(node))
+		return -ENODEV;
+	if (uclass_get_device_by_ofnode(UCLASS_CLK, node, &dev))
+		return -ENODEV;
+	priv = dev_get_priv(dev);
+	if (!priv)
+		return -ENODEV;
+	ret = rockchip_pll_set_rate(&rk3588_pll_clks[CPLL], priv->cru,
+				    CPLL, CPLL_HZ);
+	printf("ZT1PB: cpll set ret=%d\n", ret);
+	if (!ret)
+		priv->cpll_hz = CPLL_HZ;
+	rk_clrsetreg(&priv->cru->clksel_con[83], 0x7f00 | (1 << 15),
+		     (11 << 8) | (1 << 15));
+	printf("ZT1PB: con83=%08x cpll=%lu\n",
+	       readl(&priv->cru->clksel_con[83]), priv->cpll_hz);
+	return ret;
+}
